################################
# variable declarations (varDecl)
################################

variable b has_type Bool is true; 				# A boolean
variable number1 has_type Number is 123; 		# A number
variable number2 has_type Number is -123; 		# A negative number
variable numberFloat has_type Number is 12.3; 	# A float
variable someName has_type String is "123 "; 	# This is a string , not a number
variable _only_declared has_type String;

variable min has_type Number is 0;
variable max has_type Number;
max is add (number1 100);                       # 223
variable average has_type Number is divide (add (min max) 2);   # 111.5

variable complexBool has_type Number is number1 EQUALS number2; # false

variable number3 has_type Number;
variable number4 has_type Number is number3 is 500;     # number4 and number3 = 500



################################
# Statements (statement)
################################

    # exprStmt:
        # assignment
            number5 is 500;
            number6 is add (10 20);
        # logicOr
            true OR false;
        # logicAnd
            true AND true;
        # equality
            number5 EQUALS number6;
        # comparison
            number5 GREATER number6;
        # term
            add (2, 5);
            subtract (7, 2)
            multiply (number1 5)    # 123 mult 5 = 615
        # unary
            NOT true;       # false
            NOT NOT false;  # false
        # call + args (TODO)
            true;
            true (  );
            true (20);
        # primary
            true;
            "hello";
            25;
            number7;

    # ifStmt:
        if ("true") add (0 0)

        if ("false") add (10 10) else add (0 0)

    # whileStmt:
        




    # printStmt:




    # returnStmt:




    # block:
        {
            write_to_console "Hello earth !";
            write_to_console "Hello, SDU! This is a computer program.";
        }

        if (number1 EQUALS number2) {
            write_to_console "yes";
        } else {
            write_to_console "no";
        }

        {
            if (number1 EQUALS someName) {
                write_to_console number1 ; 	
            } else {
                write_to_console "nej";
            }

            variable a has_type Number is 1;
            loop_while (a LESS 10) {
                write_to_console a;
                a is add (a 1);
                a is subtract(5 cast_to Number "4");
            }
        }




