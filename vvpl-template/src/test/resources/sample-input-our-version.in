################################
# variable declarations
################################

variable a has_type Number is 3.14;
variable b has_type Number is 42;


################################
# basic arithmetics
################################

# Hun tester ikke multiply.

add (10, a);    # 13.14
add (b, 20);    # 62
a NOT_EQUALS b; #true


variable res has_type Number is mult(a b);


################################
# start block
################################

write_to_console res;
write_to_console res NOT_EQUALS 1;

################################
# Logical evaluation
################################

# Måske en god idé at teste nogle logiske udtryk?

variable t has_type Bool is true;
variable f has_type Bool is false;

variable logic_res has_type Bool is (NOT (NOT t AND NOT f)); 
variable logic_res2 has_type Bool is (t OR f);
write_to_console (logic_res EQUAL logic_res2); # Should be true. 
