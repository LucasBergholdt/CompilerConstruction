
################################################
# Example of behaviour when wrong format string 
# is cast to number
################################################


# Just to illustrate, that the program runtime is interrupted

# Correct code:
variable a has_type Number is cast_to Number "12";
write_to_console a;

# Wrong code:

# Only error reported, because the program is interrupted.
variable b has_type Number is cast_to Number "abc";
write_to_console b;

# Second (potential) error, but unreported because of the interruption. 
variable c has_type Number is cast_to Number "xyz";



